# Single-origin reverse proxy for the dev container.
#
# The browser hits ``http://localhost:3000`` and Caddy fronts:
#   - /api/* → backend (FastAPI)
#   - else   → Next.js dev server
#
# Native auth lives under /api/auth/* on the backend (docs/011 §11)
# — no separate Supabase origin to route to any more.
#
# Caddy auto-handles HTTP/1.1 → WebSocket upgrades, so Next.js HMR
# and the backend's SSE / streaming surfaces pass through unchanged.

{
	# Skip Caddy's automatic HTTPS / Let's Encrypt — dev only.
	auto_https off
	# Quieter logs: only errors, no per-request access lines (the
	# upstreams already log their own).
	log {
		output stdout
		level WARN
	}
}

:80 {
	# Backend API (includes /api/auth/*, /api/conversations/*, etc.)
	handle /api/* {
		reverse_proxy app:8000
	}

	# Everything else → Next.js dev server (Next moved to :3001
	# internally so Caddy can claim :80 → host :3000).
	handle {
		reverse_proxy app:3001
	}
}
