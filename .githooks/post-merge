#!/bin/bash
# Fires after `git pull` (which is fetch + merge) and after a
# direct `git merge`. We diff the pre-merge HEAD against post-merge
# HEAD to see what landed in this operator's working tree.
#
# `HEAD@{1}` is "where HEAD pointed before the most recent change"
# — for a merge that's the pre-merge commit, so HEAD@{1}..HEAD
# captures exactly what the merge brought in.

dir="$(dirname "$0")"
exec "$dir/_cli_reinstall" "HEAD@{1}..HEAD"
