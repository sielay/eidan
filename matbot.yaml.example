# eidan-on-matbot host config (example). Copy to `matbot.yaml` (gitignored) and supply secrets via
# env/vault. matbot is the runtime (vendored at external/matbot); eidan ships as the plugins below.
# Per eidan's gitignored-config policy this `.example` is tracked; the real `matbot.yaml`, `.data/`,
# and `.plugins/` are operator-private and gitignored.
#
# Boot (Node 24+ runs the TypeScript directly — native type-stripping, no build step):
#
#   EIDAN_DATABASE_URL=postgres://eidan_app:...@host:5432/eidan \
#   ANTHROPIC_API_KEY=sk-ant-... \
#   EIDAN_AUTH_JWT_SECRET=... \
#   MATBOT_PRINCIPAL=<a-real-eidan.users-uuid> \
#   node --import ./external/matbot/apps/cli/register.js \
#        ./external/matbot/apps/cli/src/index.ts start --config ./matbot.yaml
#
# EIDAN_DATABASE_URL must point at a Postgres with the eidan schema applied (`pnpm --filter
# @eidandev/migrate migrate`) via a NON-superuser role (e.g. eidan_app) so RLS enforces.

principal: eidan-operator # overridden by MATBOT_PRINCIPAL env (a real eidan.users UUID)

plugins:
  - ./packages/storage-postgres # storage backend FIRST (open() before any createStore)
  - ./packages/vault-postgres # encrypted secrets vault (register('Vault')); EidanSecrets service. Early, so ${NAME} resolves from the DB vault for all later plugins
  - ./packages/llm-calls # LLM cost ledger (eidan.llm_calls)
  - ./packages/tool-guard # caps oversized tool results before they re-enter context (EIDAN_TOOL_RESULT_MAX_CHARS, default 50k; 0 disables)
  - ./packages/memory # EidanMemory + remember/recall
  - ./packages/auth # WebPrincipalResolver: Bearer JWT (HS256) -> per-request Principal (RLS)
  - ./packages/notify # topic->channel routing (Slack/Telegram); dry-run unless EIDAN_NOTIFY_ROUTES
  - ./packages/jobs # delegation work-queue worker (eidan.jobs); bundles add kind handlers
  - ./packages/routines # recurring scheduled prompts (eidan.routines): poll loop runs each due routine as a turn (owner tz) and delivers via notify topic "routine". After notify + jobs. Tune with EIDAN_ROUTINE_POLL_MS / EIDAN_ROUTINE_GRACE_MIN
  - ./packages/frontend-agui # AG-UI turn stream + conversation REST (:8090)
  - ./packages/frontend-telegram # inbound Telegram chat surface (long-poll) + potem-style account linking. Bot token from vault ${EIDAN_TELEGRAM_BOT_TOKEN} OR env EIDAN_TELEGRAM_BOT_TOKEN/TELEGRAM_BOT_TOKEN; set EIDAN_WEB_URL for the /start link. A chat binds to a user via /start -> web sign-in; ${EIDAN_TELEGRAM_ALLOWLIST} (JSON {telegram_id: principal_id}) is an optional fallback. Registers TelegramChats for outbound (routines/replies). Multi-node: set EIDAN_TELEGRAM_POLL=false on all but ONE node (only one may long-poll a bot)
  - ./packages/mcp-server # inbound MCP (JSON-RPC) (:8091)
  - ./packages/a2a-server # inbound A2A agent card + message/send (:8095)
  - ./packages/procedures # sandboxed agent-authored procedures (isolated-vm); compose set via EIDAN_PROCEDURE_TOOLS (default: remember,recall)
  - ./packages/secrets-api # secure secrets HTTP API (:8092): LLM-free write path for the Settings UI (needs vault-postgres + auth)
  - ./packages/social-bluesky # Bluesky Social (bluesky_post, bluesky_search, bluesky_read_feed) via AT Protocol OAuth + vault
  - ./packages/finance-google-search-console # Google Search Console finance (gsc_performance, gsc_sitemaps, gsc_indexing_status, gsc_indexing_errors) via Google Search Console API OAuth2 + vault
  - ./packages/finance-trading212 # Trading 212 Finance (trading212_portfolio, trading212_account, trading212_trades) via Trading 212 Public API + vault
  - ./packages/social-threads # Threads Social (threads_post_thread, threads_search, threads_get_profile, threads_list_timeline) via Meta Threads API OAuth2 + vault
  - ./packages/social-facebook # Facebook Social (facebook_post_feed, facebook_search, facebook_get_profile, facebook_list_feed) via Graph API OAuth2 + vault
  - ./packages/social-x # X (Twitter) Social (x_post_tweet, x_search, x_get_profile, x_list_timeline) via X API v2 OAuth2 + vault
  - ./packages/social-linkedin # LinkedIn Social (linkedin_post, linkedin_search, linkedin_get_profile, linkedin_list_feed) via OAuth2 + vault
  - ./packages/social-mastodon # Mastodon Social (mastodon_post, mastodon_search, mastodon_get_profile, mastodon_list_timeline) via Mastodon API + bearer token + vault
  - ./packages/social-youtube # YouTube Social (youtube_post_comment, youtube_search, youtube_get_channel, youtube_list_videos) via YouTube Data API v3 + vault
  - ./packages/finance-google-trends # Google Trends Finance (google_trends_search, google_trends_top_charts, google_trends_rising_queries, google_trends_related): search volume trends, top charts, and related queries via public Google Trends API
  - ./packages/social-instagram # Instagram Social (instagram_post_feed, instagram_search, instagram_list_feed, instagram_get_profile) via Instagram Graph API OAuth2 + vault
  # Bundles append here per deploy, e.g.:  - ./packages/sage   (registers a 'code' JobHandler)

providers:
  claude:
    module: ./external/matbot/packages/plugins/providers/anthropic
    endpoint: https://api.anthropic.com
    model: claude-sonnet-4-6
    credentials:
      apiKey: ${ANTHROPIC_API_KEY}
    parameters:
      maxTokens: 4096
