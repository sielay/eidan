{
  "name": "@eidandev/finance-xero",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "eidan Xero Finance (matbot): read-through accounting over OAuth2 — invoices, contacts, chart of accounts, bank transactions, and P&L / balance-sheet reports (xero_invoices, xero_contacts, xero_accounts, xero_bank_transactions, xero_profit_and_loss, xero_balance_sheet). Per-org connect on the shared connections kit; client + rotating tokens sealed in the vault.",
  "matbotRuntime": ["node"],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../external/matbot/apps/cli/register.js --test src/*.test.ts"
  },
  "eidan": {
    "frontend": {
      "package": "frontend",
      "stylesheet": "xero.css",
      "routes": [
        { "path": "/", "component": "Connections.tsx" },
        { "path": "/callback", "component": "Callback.tsx" }
      ],
      "api": [
        { "path": "/api/finance-xero/accounts", "handler": "api/route.ts" }
      ],
      "nav": {
        "group": "Integrations",
        "sections": [
          { "id": "xero", "label": "Xero", "icon": "receipt", "href": "/p/finance-xero", "mobileHome": 6 }
        ]
      }
    }
  },
  "dependencies": {
    "@eidandev/connections-kit": "link:../connections-kit",
    "@matatbread/matbot-plugin-api": "link:../../external/matbot/packages/core/plugin-api",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
