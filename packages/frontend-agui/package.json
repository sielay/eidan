{
  "name": "@eidandev/frontend-agui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AG-UI frontend plugin: exposes the matbot turn stream as AG-UI over HTTP+SSE (POST /api/turn) for the eidan Next.js app. The engine-side chat surface; matbot's frontend-web stays dev/demo only.",
  "matbotRuntime": ["node"],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../external/matbot/apps/cli/register.js --test src/*.test.ts"
  },
  "dependencies": {
    "@matatbread/matbot-core": "link:../../external/matbot/packages/core/runner",
    "@matatbread/matbot-plugin-api": "link:../../external/matbot/packages/core/plugin-api",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
