{
  "name": "@eidandev/github",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "eidan GitHub integration (matbot): per-user GitHub API access via Personal Access Token (PAT) with repo/issue/PR/search tools.",
  "matbotRuntime": [
    "node"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../external/matbot/apps/cli/register.js --test src/*.test.ts"
  },
  "eidan": {
    "frontend": {
      "package": "frontend",
      "stylesheet": "github.css",
      "routes": [
        {
          "path": "/",
          "component": "Connections.tsx"
        }
      ],
      "api": [
        {
          "path": "/api/github/accounts",
          "handler": "api/route.ts"
        }
      ],
      "nav": {
        "group": "Integrations",
        "sections": [
          {
            "id": "github",
            "label": "GitHub",
            "icon": "link",
            "href": "/p/github",
            "mobileHome": null
          }
        ]
      }
    }
  },
  "dependencies": {
    "@eidandev/connections-kit": "link:../connections-kit",
    "@matatbread/matbot-plugin-api": "link:../../external/matbot/packages/core/plugin-api",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
