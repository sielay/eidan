{
  "name": "@eidandev/crm",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Charles CRM — venture-scoped deals pipeline, contacts, and activity tracking (kanban, list, timeline).",
  "matbotRuntime": [
    "node"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../external/matbot/apps/cli/register.js --test src/*.test.ts"
  },
  "eidan": {
    "frontend": {
      "package": "frontend",
      "stylesheet": "crm.css",
      "routes": [
        { "path": "/", "component": "Crm.tsx" },
        { "path": "/*", "component": "Crm.tsx" }
      ],
      "api": [
        { "path": "/api/crm/pipeline", "handler": "api/pipeline.ts" },
        { "path": "/api/crm/contacts", "handler": "api/contacts.ts" },
        { "path": "/api/crm/deals", "handler": "api/deals.ts" },
        { "path": "/api/crm/activities", "handler": "api/activities.ts" }
      ],
      "nav": {
        "group": "Business",
        "sections": [
          {
            "id": "crm",
            "label": "CRM",
            "icon": "analytics",
            "href": "/p/crm",
            "mobileHome": null
          }
        ]
      }
    }
  },
  "dependencies": {
    "@matatbread/matbot-plugin-api": "link:../../external/matbot/packages/core/plugin-api",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
