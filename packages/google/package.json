{
  "name": "@eidandev/google",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "eidan Google (matbot): read-through Gmail over OAuth2 — gmail_list_recent + gmail_read, plus a Connections admin screen (OAuth connect + per-account vault wiring).",
  "matbotRuntime": ["node"],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../external/matbot/apps/cli/register.js --test src/*.test.ts"
  },
  "eidan": {
    "frontend": {
      "package": "frontend",
      "stylesheet": "google.css",
      "routes": [
        { "path": "/", "component": "Connections.tsx" },
        { "path": "/callback", "component": "Callback.tsx" }
      ],
      "api": [
        { "path": "/api/google/accounts", "handler": "api/route.ts" }
      ],
      "nav": {
        "group": "Integrations",
        "sections": [
          { "id": "gmail", "label": "Google", "icon": "mail", "href": "/p/google", "mobileHome": 5 }
        ]
      }
    }
  },
  "dependencies": {
    "@matatbread/matbot-plugin-api": "link:../../external/matbot/packages/core/plugin-api",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
