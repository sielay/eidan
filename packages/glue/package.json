{
  "name": "@eidandev/glue",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "eidan Glue marketing adapter (matbot): drive the operator's Glue marketing suite — web/funnel analytics, conversion-funnel management, subscriber lists & topics, and bulk email campaigns (glue_analytics, glue_funnels, glue_lists, glue_campaigns) — by consuming Glue's MCP server over JSON-RPC. Pulls from Glue; stores nothing locally.",
  "matbotRuntime": [
    "node"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../external/matbot/apps/cli/register.js --test src/*.test.ts"
  },
  "eidan": {
    "frontend": {
      "package": "frontend",
      "stylesheet": "glue.css",
      "routes": [
        {
          "path": "/",
          "component": "Setup.tsx"
        }
      ],
      "nav": {
        "group": "Integrations",
        "sections": [
          {
            "id": "glue",
            "label": "Glue marketing",
            "icon": "share",
            "href": "/p/glue",
            "mobileHome": null
          }
        ]
      }
    }
  },
  "dependencies": {
    "@matatbread/matbot-plugin-api": "link:../../external/matbot/packages/core/plugin-api"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
