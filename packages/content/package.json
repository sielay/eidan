{
  "name": "@eidandev/content",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Content — media/campaign tools. Starts with image_generate (OpenAI gpt-image-1 → downloadable, card-linkable artifacts); grows into the content-workflow engine.",
  "matbotRuntime": [
    "node"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../external/matbot/apps/cli/register.js --test src/*.test.ts"
  },
  "eidan": {
    "frontend": {
      "package": "frontend",
      "routes": [
        { "path": "/", "component": "Content.tsx" },
        { "path": "/*", "component": "Content.tsx" }
      ],
      "api": [
        { "path": "/api/content/brand", "handler": "api/brand.ts" }
      ],
      "nav": {
        "group": "Plan",
        "sections": [
          {
            "id": "content",
            "label": "Content",
            "icon": "analytics",
            "href": "/p/content",
            "mobileHome": null
          }
        ]
      }
    }
  },
  "dependencies": {
    "@matatbread/matbot-plugin-api": "link:../../external/matbot/packages/core/plugin-api",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
