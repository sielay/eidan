{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eidan.dev/core/plugin/PluginManifest/v1.json",
  "title": "PluginManifest",
  "description": "Shape of plugins/<name>/plugin.yaml — the single source of truth for a plugin's identity, dependencies, declared access, and extension points (docs/001 §1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "tier",
    "license"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1,
      "description": "Manifest schema version. Always 1 for the docs/001 §1.1 shape."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 64,
      "description": "Globally unique slug used as the plugin's identifier in logs, DB rows, and the plugin_<name_underscored> schema. The plugins/<name>/ directory MUST equal this value (docs/001 §1.2)."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$",
      "description": "Plugin version, semver 2.0.0. MUST be strictly increasing across installed releases (docs/001 §1.2)."
    },
    "display_name": {
      "type": "string",
      "description": "Human-facing label shown in the plugin admin UI."
    },
    "description": {
      "type": "string",
      "description": "One-paragraph summary shown in the plugin admin UI."
    },
    "tier": {
      "type": "string",
      "enum": ["core", "pro", "commercial"],
      "description": "Which bundle the plugin belongs to. Metadata only — access control is enforced at the GitHub repo level (docs/001 §1.2)."
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 64,
          "description": "Slug of the bundle this plugin ships in. Used by `eidan admin plugin remove <bundle>` to scope a multi-plugin removal (docs/018 §3)."
        },
        "kind": {
          "type": "string",
          "enum": ["thematic", "baseline"],
          "default": "thematic",
          "description": "Whether the bundle is a thematic bundle or the universal paid baseline. The CLI auto-removes baseline bundles when no thematic bundle remains installed (docs/018 §3)."
        }
      },
      "description": "Bundle membership metadata. Omitted for `tier: core` plugins that ship in this repo. Set on every plugin shipped in a paid bundle so the CLI can scope `plugin remove <bundle>` and reason about baseline auto-removal (docs/018 §3)."
    },
    "license": {
      "type": "string",
      "description": "SPDX licence identifier."
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "email": {"type": "string"}
        }
      },
      "description": "Authors / maintainers, listed in the plugin admin UI."
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "PEP 440 / npm-style version range."
          }
        }
      },
      "description": "Other plugins required at load time. MUST form a DAG; cycles are a fatal load error (docs/001 §1.2)."
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eidan": {"type": "string"},
        "python": {"type": "string"},
        "node": {"type": "string"}
      },
      "description": "Required host capabilities. Version strings are PEP 440 / npm-style ranges."
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Env var name in UPPER_SNAKE_CASE."
          },
          "required": {"type": "boolean", "default": false},
          "default": {"type": "string"},
          "description": {"type": "string"}
        }
      },
      "description": "Env vars the plugin reads. Reading an undeclared env var raises UndeclaredAccessError (docs/001 §1.2)."
    },
    "vault": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "Dotted vault key the plugin reads."
          },
          "required": {"type": "boolean", "default": false},
          "description": {"type": "string"}
        }
      },
      "description": "Vault keys the plugin reads. Reading an undeclared key raises UndeclaredAccessError (docs/001 §1.2)."
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": {
        "entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Python module:ClassName tuple resolving to the Plugin subclass (docs/001 §2.2)."
        },
        "routes_prefix": {
          "type": "string",
          "pattern": "^/",
          "description": "URL prefix the plugin's FastAPI routers mount under (docs/001 §2.2)."
        }
      },
      "description": "Backend extension point. Omitted when the plugin contributes no Python code."
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string",
          "description": "Path to the plugin's web package, relative to the plugin root."
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "component"],
            "properties": {
              "path": {"type": "string"},
              "component": {"type": "string"}
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "component"],
            "properties": {
              "slot": {"type": "string"},
              "component": {"type": "string"}
            }
          }
        },
        "settings_panel": {"type": "string"}
      },
      "description": "Frontend extension point. Omitted when the plugin contributes no UI."
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "dir": {
          "type": "string",
          "description": "Path to the migrations directory, relative to the plugin root."
        },
        "driver": {
          "type": "string",
          "enum": ["alembic", "sql"],
          "default": "alembic"
        }
      },
      "description": "Migration extension point (docs/001 §4)."
    },
    "behaviours": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "handler"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Globally unique, plugin-prefixed behaviour id."
          },
          "trigger": {
            "type": "string",
            "pattern": "^(event|cron|webhook|schedule|agent):.+$",
            "description": "Trigger spec — one of event:/cron:/webhook:/schedule:/agent: (docs/001 §5.1)."
          },
          "handler": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$",
            "description": "Python module:function reference for the handler."
          }
        }
      },
      "description": "Agentic-loop behaviours the plugin registers (docs/001 §5)."
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "transport": {
          "type": "string",
          "enum": ["stdio", "sse"]
        },
        "tools": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Public allowlist of tool names externally exposed via MCP (docs/001 §7)."
        }
      },
      "description": "Optional MCP server stanza (docs/001 §7)."
    }
  }
}
