{
  "name": "@eidan/schemas",
  "version": "0.2.0",
  "private": true,
  "description": "Eidan JSON Schema source of truth — generates Zod + Pydantic. See docs/004_SCHEMAS.md.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "schemas"
  ],
  "scripts": {
    "gen:ts": "node scripts/gen-ts.mjs",
    "gen:py": "bash scripts/gen-py.sh",
    "gen": "pnpm gen:ts && pnpm gen:py",
    "check": "bash scripts/check.sh"
  },
  "devDependencies": {
    "json-schema-to-zod": "2.6.1"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
