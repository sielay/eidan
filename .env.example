# Example environment for an eidan host. Copy to `.env` and edit.
# Boolean values are "true" / "false". Numerics are plain. Comments
# starting with `#` are ignored. Anything not exported by the runner's
# config loader (apps/backend/eidan_backend/config.py) is documented
# here for the operator's benefit, not consumed automatically.
#
# Native auth subsystem (docs/011 §11): magic-link sign-in, RS256
# JWT issuance, single-operator pin via EIDAN_AUTH_ALLOWED_EMAIL,
# Postgres-backed encrypted secrets vault. No Supabase coupling.

# ─── Database ────────────────────────────────────────────────────────
# asyncpg-style URL. The smoke harness rewrites this to a temp DB.
#
# In the dev container the compose stack pins this to the bundled
# Postgres sidecar (postgresql+asyncpg://eidan:eidan@db:5432/eidan).
# The value below applies when running outside the container
# (bare-metal, Pi).
#
# In production, point this at the dedicated `eidan_app` Postgres role
# provisioned by migrations/versions/20260514_000005_eidan_app_role.py
# (docs/011 §9.2). The role owns eidan.* and is not BYPASSRLS.
#
#   DATABASE_URL=postgresql+asyncpg://eidan_app:<password>@host:5432/eidan
DATABASE_URL=postgresql+asyncpg://eidan:eidan@localhost:5432/eidan

# Provision the dedicated `eidan_app` Postgres role on `alembic upgrade`.
# Production: set both to "true" + a strong password ONCE at first
# deploy, then rotate the password by re-running the migration with a
# new value (it ALTERs the role on subsequent applies). Dev: leave
# unset to keep using whatever role DATABASE_URL points at.
# EIDAN_CREATE_APP_ROLE=true
# EIDAN_APP_DB_PASSWORD=

# ─── Auth: native (docs/011 §11) ─────────────────────────────────────
#
# Master encryption key. HKDF-SHA256-derives a Fernet key used to
# seal the RS256 signing keypair (eidan.auth_keypair), TOTP secrets
# (eidan.auth_mfa_totp), and every entry in eidan.secrets_vault.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating: set a new value, then in psql:
#   DELETE FROM eidan.auth_keypair;
#   DELETE FROM eidan.secrets_vault;
# (the keypair regenerates on next boot; the vault rows are lost
# unless you re-seed them under the new key.)
EIDAN_AUTH_MASTER_KEY=

# Single-operator allow-list. Magic-link requests for any other
# email are refused (with a generic "sent" envelope so the response
# doesn't enumerate valid emails). Leave UNSET in dev to refuse
# all logins — the host's safer default than "anyone can log in".
EIDAN_AUTH_ALLOWED_EMAIL=

# ─── SMTP (docs/011 §16) ─────────────────────────────────────────────
# Magic-link delivery. Unset in dev — the host logs the link to
# logs/backend.log and echoes it on the /api/auth/magic-link
# response body when EIDAN_DEPLOYMENT_MODE != production.
#
# EIDAN_SMTP_HOST=smtp.example.com
# EIDAN_SMTP_PORT=587
# EIDAN_SMTP_USER=
# EIDAN_SMTP_PASSWORD=
# EIDAN_SMTP_FROM=eidan-no-reply@example.com
# EIDAN_SMTP_STARTTLS=1

# Deployment mode. ``production`` switches the refresh cookie to
# secure-only and suppresses the dev echo of magic links on the
# /api/auth/magic-link response. Anything else (dev / unset) keeps
# the dev conveniences on.
# EIDAN_DEPLOYMENT_MODE=production

# ─── Providers (docs/007_PROVIDER_ABSTRACTION.md §7.1) ───────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Default routing model when an agent has not pinned one.
EIDAN_DEFAULT_MODEL=claude-opus-4-7

# ─── Rate-table overrides (docs/010_COST_BUDGETING.md §3.4) ──────────
# USD per 1M tokens, four axes per model. The model id is upper-cased
# with every non-alphanumeric character collapsed to `_`:
#   claude-opus-4-7              → CLAUDE_OPUS_4_7
#   claude-sonnet-4-6            → CLAUDE_SONNET_4_6
#   claude-haiku-4-5-20251001    → CLAUDE_HAIKU_4_5_20251001
# Unset axes fall through to the adapter's built-in default.
#
# EIDAN_PRICE_CLAUDE_OPUS_4_7_INPUT=15.0
# EIDAN_PRICE_CLAUDE_OPUS_4_7_OUTPUT=75.0
# EIDAN_PRICE_CLAUDE_OPUS_4_7_CACHE_READ=1.50
# EIDAN_PRICE_CLAUDE_OPUS_4_7_CACHE_CREATION=18.75
#
# EIDAN_PRICE_CLAUDE_SONNET_4_6_INPUT=3.0
# EIDAN_PRICE_CLAUDE_SONNET_4_6_OUTPUT=15.0
# EIDAN_PRICE_CLAUDE_SONNET_4_6_CACHE_READ=0.30
# EIDAN_PRICE_CLAUDE_SONNET_4_6_CACHE_CREATION=3.75
#
# EIDAN_PRICE_CLAUDE_HAIKU_4_5_20251001_INPUT=1.0
# EIDAN_PRICE_CLAUDE_HAIKU_4_5_20251001_OUTPUT=5.0
# EIDAN_PRICE_CLAUDE_HAIKU_4_5_20251001_CACHE_READ=0.10
# EIDAN_PRICE_CLAUDE_HAIKU_4_5_20251001_CACHE_CREATION=1.25

# ─── REPL / surface ──────────────────────────────────────────────────
# Operator's IANA time zone, used as the fallback when the CLI cannot
# resolve the local zone via `tzlocal`. Issue #51 — every outbound turn
# carries TZ so the loop interprets "today" / "tomorrow" against the
# user's clock, not the server's. Web composer resolves it from the
# browser; CLI uses tzlocal; both fall back here.
# EIDAN_DEFAULT_TZ=Europe/London

# `eidan repl` with EIDAN_BACKEND_URL set posts turns to the HTTP
# surface instead of running the loop in-process. Leave unset for
# the simpler in-process dev path.
# EIDAN_BACKEND_URL=http://localhost:8000

# HTTP server bind. `eidan admin server` reads these.
# EIDAN_HTTP_HOST=0.0.0.0
# EIDAN_HTTP_PORT=8000
# Comma-separated allowlist for browser origins. Default is the
# Next.js dev server. Add production origins here when deploying.
# EIDAN_HTTP_CORS_ORIGINS=http://localhost:3000,https://app.example.com

# ─── Plugins ─────────────────────────────────────────────────────────
# Where the host looks for plugin folders. Defaults to `<repo>/plugins`
# for the in-tree default. Override when running outside a checkout.
# EIDAN_PLUGINS_DIR=/opt/eidan/plugins

# ─── Logging ─────────────────────────────────────────────────────────
EIDAN_LOG_LEVEL=INFO
