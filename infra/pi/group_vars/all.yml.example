# Example vars file for the eidan Pi playbook.
#
# Copy once to your gitignored .eidan/ dir and edit:
#
#   cp infra/pi/group_vars/all.yml.example .eidan/vars.yml
#   chmod 0600 .eidan/vars.yml
#   $EDITOR .eidan/vars.yml
#
# Run with: ansible-playbook ... -e @.eidan/vars.yml ...
#
# Treat this file as a secret. Once you're past the dev-loop phase
# encrypt it in place:
#
#   ansible-vault encrypt .eidan/vars.yml
#
# Ansible reads vaulted files transparently when you add
# --ask-vault-pass or --vault-password-file to ansible-playbook.

# --- Database -------------------------------------------------------
# postgres on the Pi (option A in DEPLOYMENT.md §3.4), Supabase (B),
# or anything else with a stable postgresql+asyncpg URL.
eidan_database_url: "postgresql+asyncpg://eidan_app:CHANGE-ME@127.0.0.1:5432/eidan"

# --- Auth -----------------------------------------------------------
# Generate ONCE with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Must be byte-identical on every node sharing this Postgres. Back it
# up out-of-band (1Password / paper). Rotation is a separate dance —
# see docs/012_SECRETS.md §10.
eidan_auth_master_key: "REPLACE-ME-WITH-48-BYTE-TOKEN"
eidan_auth_allowed_email: "you@yourdomain.com"
eidan_deployment_mode: "production"

# --- HTTP listener --------------------------------------------------
eidan_http_host: "0.0.0.0"
eidan_http_port: 8000

# --- LLM provider ---------------------------------------------------
eidan_provider: "ollama"
eidan_default_model: "phi3"
ollama_base_url: "http://127.0.0.1:11434/v1"

# --- Node identity (optional, see docs/024_NODE_TELEMETRY.md) -------
# Pin these if one Pi runs multiple eidan processes. Auto-detected
# from hostname otherwise.
# eidan_node_id: "pi-kasha"
# eidan_node_type: "pi"

# --- Plugin install -------------------------------------------------
# Where the backend reads plugins from. Outside /opt/eidan/ so
# `git pull` of core never disturbs the installed bundles.
eidan_plugins_dir: "/var/lib/eidan/plugins"

# `gh:<org>` clones from github.com/<org>/<bundle>. The PAT needs
# `repo:read` on the private bundle repos. Kept here (not in
# /etc/eidan/eidan.env) so the long-lived service process doesn't
# carry it in its environment.
eidan_plugin_source: "gh:sielay"
eidan_github_token: "REPLACE-ME-WITH-GH-PAT"

# Bundles to install. The playbook is idempotent on bundle name —
# adding to this list installs new ones; removing from this list
# does NOT uninstall (see DEPLOYMENT.md §3.12 for the prune flow).
eidan_bundles:
  - eidan-pro
  # - eidan-sage
  # - eidan-lifestyle
  # - eidan-business

# --- Sentry plugin --------------------------------------------------
# Sentry is tier:core and enabled by default. Disable here to silence
# the 5-minute tick during noisy testing.
eidan_sentry_enabled: 1
eidan_sentry_tick_interval: "PT5M"
eidan_sentry_model: "phi3"

# --- SMTP for magic-link (optional) ---------------------------------
# Omit to fall back to "link printed in journald".
# eidan_smtp_host: "smtp.fastmail.com"
# eidan_smtp_port: 465
# eidan_smtp_user: ""
# eidan_smtp_password: ""
# eidan_smtp_from: "eidan@yourdomain.com"
