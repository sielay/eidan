# Example Ansible inventory for an eidan Pi deploy.
#
# Copy once to your gitignored .eidan/ dir and edit:
#
#   mkdir -p .eidan
#   cp infra/pi/inventory.ini.example .eidan/inventory.ini
#   $EDITOR .eidan/inventory.ini
#
# `ansible_user` is the SSH login on the Pi — typically your normal
# admin user (e.g. `pi`, `sielay`), NOT the service user `eidan`.
# The playbook escalates to root via `become: true` for system tasks
# and drops to `eidan` for plugin commands.

[eidan_pi]
kasha ansible_host=192.168.1.100 ansible_user=CHANGE-ME ansible_ssh_private_key_file=~/.ssh/id_ed25519

[eidan_pi:vars]
ansible_python_interpreter=/usr/bin/python3
