#!/bin/bash
# Example backend healthcheck + restart guard for a self-hosted
# eidan deploy (bare metal / Raspberry Pi / long-lived VM).
#
# Copy once and leave it alone — this file ships as a generic
# EXAMPLE so a `git pull` from upstream can never disturb your
# installed script. Per-deploy values belong in the unit file's
# `Environment=` lines (see below), NOT in this script:
#
#   sudo install -m 0755 infra/systemd/eidan-healthcheck.sh.example \
#       /usr/local/bin/eidan-healthcheck.sh
#
# Pair with the matching systemd unit + timer in this directory.
#
# Behaviour: probe the backend's unauthenticated liveness endpoint
# (`/api/healthz` — process-up only, no DB or downstream check); on
# failure, increment a counter on disk; on `THRESHOLD` consecutive
# failures, log to syslog and restart the backend service. The
# counter resets the moment a probe succeeds.
#
# Per-deploy overrides come from env (set them in the unit file's
# `Environment=` lines, NOT by editing this script). Defaults work
# for a backend bound to 127.0.0.1:8000 with the service named
# `eidan-backend`:
#
#   EIDAN_HEALTHCHECK_URL       default: http://127.0.0.1:8000/api/healthz
#   EIDAN_HEALTHCHECK_TIMEOUT   default: 10  (seconds, passed to curl --max-time)
#   EIDAN_HEALTHCHECK_THRESHOLD default: 2   (consecutive failures before restart)
#   EIDAN_HEALTHCHECK_SERVICE   default: eidan-backend
#   EIDAN_HEALTHCHECK_STATE     default: /run/eidan-healthcheck.fails
#
# `curl -fsS` is load-bearing: `-f` makes non-2xx exit non-zero so
# 401 / 5xx responses are correctly treated as failures rather than
# silently counted as healthy. `/api/healthz` is on the middleware's
# unauthenticated-paths allowlist (apps/backend/eidan_backend/http/auth.py),
# so the probe does NOT need a bearer token.

set -u

URL="${EIDAN_HEALTHCHECK_URL:-http://127.0.0.1:8000/api/healthz}"
TIMEOUT="${EIDAN_HEALTHCHECK_TIMEOUT:-10}"
THRESHOLD="${EIDAN_HEALTHCHECK_THRESHOLD:-2}"
SERVICE="${EIDAN_HEALTHCHECK_SERVICE:-eidan-backend}"
STATE_FILE="${EIDAN_HEALTHCHECK_STATE:-/run/eidan-healthcheck.fails}"

# Keep stderr — `-S` surfaces curl's failure reason ("connection
# refused", "operation timed out", …) and systemd captures it into
# the journal so `journalctl -u eidan-healthcheck.service` is
# enough to debug a stuck probe.
if curl -fsS --max-time "$TIMEOUT" -o /dev/null "$URL"; then
    rm -f "$STATE_FILE"
    exit 0
fi

fails=$(( $(cat "$STATE_FILE" 2>/dev/null || echo 0) + 1 ))
echo "$fails" > "$STATE_FILE"

if [ "$fails" -ge "$THRESHOLD" ]; then
    logger -t eidan-healthcheck "FAIL #$fails — restarting $SERVICE"
    rm -f "$STATE_FILE"
    if ! systemctl restart "$SERVICE"; then
        exit 2
    fi
    exit 1
else
    logger -t eidan-healthcheck "FAIL #$fails (threshold $THRESHOLD) — not restarting yet"
    exit 1
fi
