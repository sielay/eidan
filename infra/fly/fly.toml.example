# Example Fly.io app config for an eidan backend.
#
# This file is shipped as an EXAMPLE on purpose: copy it once to the
# repo root as `fly.toml` (gitignored — see /fly.toml in .gitignore)
# and edit your copy. The `[build] dockerfile` path below is resolved
# by flyctl **relative to the config file's directory**, which is why
# the copy must live at the repo root, alongside `infra/`. Upstream
# eidan never carries your `app = ...` value or domain, so a `git
# pull` from upstream can never disturb your deploy.
#
# Workflow (full recipe in docs/DEPLOYMENT.md §4):
#
#   1. cp infra/fly/fly.toml.example fly.toml      # at the repo root
#   2. Edit `app`, `primary_region`, `EIDAN_HTTP_CORS_ORIGINS`.
#   3. Set secrets (NEVER in this file): `fly secrets set --app <app> ...`.
#   4. fly deploy                                   # auto-picks ./fly.toml
#
# Paid bundles are baked into the image at build time on the
# operator's laptop (the CLI assembles a build context that
# includes the bundle plugins resolved from sibling repos). The
# running machine never clones a private repo and never holds a
# GitHub PAT. See docs/DEPLOY_FLY_BOOTSTRAP.md and
# docs/DEPLOYMENT.md for the full deploy flow.
#
# Only non-secret runtime config belongs in [env]. Secrets live in
# `fly secrets set` and are surfaced to the process as env vars at
# runtime.

app            = "eidan-api"   # change me
primary_region = "lhr"          # change me to your nearest Fly region

[build]
  dockerfile = "infra/fly/Dockerfile"

[http_service]
  internal_port        = 8000
  force_https          = true
  auto_stop_machines   = "stop"
  auto_start_machines  = true
  min_machines_running = 0

  # Health check pinned at the core /api/healthz endpoint. Without
  # this block the Fly proxy routes the first cold-start request to a
  # machine that's still booting and returns a 502 until uvicorn comes
  # up — Fly's dashboard misdiagnoses this as "App is not listening to
  # the expected port". With the check defined, the proxy queues the
  # request until /api/healthz reports 200.
  [[http_service.checks]]
    interval     = "15s"
    timeout      = "5s"
    grace_period = "10s"
    method       = "GET"
    path         = "/api/healthz"

  [http_service.concurrency]
    type       = "requests"
    soft_limit = 25
    hard_limit = 50

[env]
  # Non-secret runtime config only. Everything else goes via
  # `fly secrets set` (see docs/DEPLOY_FLY_BOOTSTRAP.md).
  EIDAN_HTTP_HOST         = "0.0.0.0"
  EIDAN_DEPLOYMENT_MODE   = "production"
  # Comma-separated list of origins the Next.js frontend is served
  # from. Change to your domain.
  EIDAN_HTTP_CORS_ORIGINS = "https://app.example.com"

  # Sentry tick: defaults OFF on Fly (the loop is intended to call a
  # model, so leaving it on burns LLM cost on every Fly machine). Set
  # to "1" to opt in here — typically only if this Fly app is your
  # primary long-lived node and there is no Pi or other always-on
  # host running the tick. See plugins/sentry/plugin.yaml.
  # EIDAN_SENTRY_ENABLED  = "1"
