{# Rendered by infra/pi/playbook.yml — do not edit on the Pi. #}
{# Source of truth is .eidan/vars.yml on your laptop. #}

# --- Database ------------------------------------------------------
DATABASE_URL={{ eidan_database_url }}

# --- Auth ----------------------------------------------------------
EIDAN_AUTH_MASTER_KEY={{ eidan_auth_master_key }}
EIDAN_AUTH_ALLOWED_EMAIL={{ eidan_auth_allowed_email }}
EIDAN_DEPLOYMENT_MODE={{ eidan_deployment_mode }}

# --- HTTP listener -------------------------------------------------
EIDAN_HTTP_HOST={{ eidan_http_host }}
EIDAN_HTTP_PORT={{ eidan_http_port }}

# --- LLM provider --------------------------------------------------
EIDAN_PROVIDER={{ eidan_provider }}
OLLAMA_BASE_URL={{ ollama_base_url }}
EIDAN_DEFAULT_MODEL={{ eidan_default_model }}

{% if eidan_node_id is defined %}
# --- Node identity -------------------------------------------------
EIDAN_NODE_ID={{ eidan_node_id }}
{% if eidan_node_type is defined %}
EIDAN_NODE_TYPE={{ eidan_node_type }}
{% endif %}
{% endif %}

# --- Plugin discovery ----------------------------------------------
# EIDAN_PLUGINS_DIR is unset on purpose (slice C of #104): bundle
# plugins are rsynced into /opt/eidan/plugins/ alongside core
# plugins by the laptop-side build context, so the backend's
# default discovery root (the eidan checkout's plugins/) is the
# right one. Set EIDAN_PLUGINS_DIR via .eidan/vars.yml for
# operator-specific layouts (e.g. local dev pointing at a
# scratchpad plugin tree).
{% if eidan_disabled_plugins is defined and eidan_disabled_plugins %}
EIDAN_DISABLED_PLUGINS={{ eidan_disabled_plugins }}
{% endif %}

{% if eidan_extra_env is defined and eidan_extra_env %}
# --- Plugin pass-through env (topology.yml `extra_env:`) ----------
{% for k, v in eidan_extra_env | dictsort %}
{{ k }}={{ v }}
{% endfor %}
{% endif %}

# --- Sentry --------------------------------------------------------
EIDAN_SENTRY_ENABLED={{ eidan_sentry_enabled }}
EIDAN_SENTRY_TICK_INTERVAL={{ eidan_sentry_tick_interval }}
EIDAN_SENTRY_MODEL={{ eidan_sentry_model }}

{% if eidan_smtp_host is defined %}
# --- SMTP ----------------------------------------------------------
EIDAN_SMTP_HOST={{ eidan_smtp_host }}
EIDAN_SMTP_PORT={{ eidan_smtp_port }}
EIDAN_SMTP_USER={{ eidan_smtp_user }}
EIDAN_SMTP_PASSWORD={{ eidan_smtp_password }}
EIDAN_SMTP_FROM={{ eidan_smtp_from }}
{% endif %}

{% if eidan_log_forward_url is defined %}
# --- Log forwarding (BetterStack / Datadog / Axiom / Loki) --------
EIDAN_LOG_FORWARD_URL={{ eidan_log_forward_url }}
{% if eidan_log_forward_token is defined %}
EIDAN_LOG_FORWARD_TOKEN={{ eidan_log_forward_token }}
{% endif %}
{% if eidan_log_forward_headers is defined %}
EIDAN_LOG_FORWARD_HEADERS={{ eidan_log_forward_headers }}
{% endif %}
{% if eidan_log_forward_level is defined %}
EIDAN_LOG_FORWARD_LEVEL={{ eidan_log_forward_level }}
{% endif %}
{% if eidan_log_forward_timeout is defined %}
EIDAN_LOG_FORWARD_TIMEOUT={{ eidan_log_forward_timeout }}
{% endif %}
{% if eidan_log_forward_queue_size is defined %}
EIDAN_LOG_FORWARD_QUEUE_SIZE={{ eidan_log_forward_queue_size }}
{% endif %}
{% endif %}
