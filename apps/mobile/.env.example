# SPDX-License-Identifier: AGPL-3.0-or-later
# Eidan native shell (Capacitor) — per-deploy configuration.
# Copy to a local, gitignored .env and source it before running `cap sync` / `cap add`.
# These are read by capacitor.config.ts at sync time. NEVER hardcode an operator host
# into tracked files (see the repo's gitignored-config policy).

# Required for the shell to load the live web front door. Point at your Eidan host.
# Example only — replace with your own host. Leave unset to use the static fallback page.
EIDAN_MOBILE_SERVER_URL=https://eidan.example.org

# Reverse-DNS application id and display name (optional overrides).
EIDAN_MOBILE_APP_ID=dev.eidan.app
EIDAN_MOBILE_APP_NAME=Eidan

# Set to 1 ONLY to allow plaintext http:// (e.g. a LAN host with no TLS). Default off.
# EIDAN_MOBILE_ALLOW_CLEARTEXT=1
