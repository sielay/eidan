# SPDX-License-Identifier: AGPL-3.0-or-later
# Native projects + build artifacts for the Capacitor shell.
#
# The ios/ and android/ projects are GENERATED by `cap add` and are not committed to
# core — they are re-creatable from capacitor.config.ts at any time. If an operator wants
# to track customised native projects, they do so in their own fork/private repo. Remove
# the ios/ and android/ lines below to commit them deliberately.

# Generated native projects (regenerate with `cap add ios` / `cap add android`)
/ios/
/android/

# In case native projects ARE committed later, still ignore their build caches:
# iOS / CocoaPods / Xcode
ios/App/Pods/
ios/App/Podfile.lock
ios/App/build/
ios/DerivedData/
**/*.xcuserstate
**/xcuserdata/

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
*.iml

# Capacitor / web sync output
.capacitor/

# Local env (host URL etc.) — never commit
.env
.env.local
