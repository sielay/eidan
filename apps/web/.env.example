# apps/web — the reference Next.js UI (the same-origin front door over the matbot engine).
#
# The browser talks ONLY to this app. The catch-all proxy (src/app/api/[...path]) forwards
# auth/chat/conversations to the engine; the other /api/* routes read Postgres directly (the
# dashboards). NEXT_PUBLIC_* is baked into the browser bundle — never put secrets there.

# Browser-facing API base. Leave EMPTY so all /api/* calls are same-origin (hit this app), which
# keeps the auth refresh cookie first-party. (A non-empty value points the client straight at the
# engine and reintroduces the cross-origin cookie problem — not recommended.)
NEXT_PUBLIC_EIDAN_BACKEND_URL=

# --- server-side only (NOT exposed to the browser) ---

# Where the proxy forwards auth/chat/conversations.
EIDAN_ENGINE_URL=http://localhost:8090

# Postgres for the dashboard data routes (cost, knowledge, jobs, nodes, …). Same DB the engine uses.
EIDAN_DATABASE_URL=postgres://eidan_app:...@host:5432/eidan?sslmode=no-verify

# HS256 secret the data routes verify the bearer token with — MUST match the engine's
# EIDAN_AUTH_JWT_SECRET so a token minted by either side validates on both.
EIDAN_AUTH_JWT_SECRET=
