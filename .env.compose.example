# eidan self-host (docker compose). Copy to .env, fill in, then: docker compose up -d
# ---------------------------------------------------------------------------------

# Required ---------------------------------------------------------------
# Your Anthropic API key (the default LLM provider).
ANTHROPIC_API_KEY=sk-ant-...
# A long random secret shared by the engine + web (token signing/verification).
#   generate:  openssl rand -hex 32
EIDAN_AUTH_JWT_SECRET=
# The single email allowed to sign in (magic-link is gated to this address).
EIDAN_AUTH_ALLOWED_EMAIL=you@example.com

# Database ---------------------------------------------------------------
# Leave these to use the bundled Postgres. To use an external DB (Supabase/Neon),
# set EIDAN_DATABASE_URL and you can stop the `postgres` service.
POSTGRES_PASSWORD=eidan
EIDAN_DATABASE_URL=postgres://eidan:eidan@postgres:5432/eidan

# Public URL + port ------------------------------------------------------
# The URL users hit (used to build magic-link URLs). Set to your domain in prod.
EIDAN_PUBLIC_ORIGIN=http://localhost:3001
EIDAN_WEB_PORT=3001

# Email (optional) -------------------------------------------------------
# Without SMTP, the magic link is shown on screen (fine for a single operator).
# With SMTP, it's emailed.
# EIDAN_SMTP_HOST=smtp.example.com
# EIDAN_SMTP_PORT=587
# EIDAN_SMTP_SECURE=
# EIDAN_SMTP_USER=
# EIDAN_SMTP_PASS=
# EIDAN_SMTP_FROM=eidan <no-reply@example.com>

# Jobs / worker ----------------------------------------------------------
# Comma list of job kinds this node serves; add a bundle's kind (e.g. chat,code).
EIDAN_JOB_KINDS=chat
# Boot identity (a real eidan.users UUID). Optional — created on first login.
# MATBOT_PRINCIPAL=

# Images (optional) ------------------------------------------------------
# Pin to published builds, or leave unset to `docker compose build` locally.
# EIDAN_ENGINE_IMAGE=ghcr.io/sielay/eidan-engine:latest
# EIDAN_WEB_IMAGE=ghcr.io/sielay/eidan-web:latest
