.DS_Store
# Claude Code creates worktrees here for parallel branches.
.claude/worktrees/

# Local config / secrets
.env
.env.local
# Secrets vault passphrase — NEVER commit. (.env.enc, the AES-256 sealed blob, IS committable.)
.vault-pass
~/.eidan/
.eidan/
.eidan-runtime/

# Fly.io — the operator's gitignored fly.toml lives at the repo root.
/fly.toml

# Node / pnpm
node_modules/
.next/
out/
.pnpm-store/
.turbo/
logs/

# matbot runtime (operator-private). The host config + its runtime state live
# next to it; only matbot.yaml.example is tracked.
/matbot.yaml
/.data/
/.plugins/

# local dev (not for the repo)
matbot.local.yaml
/dev-up.sh
/dev-down.sh

# Bundles & their assembled web artifacts are dropped into the tree by `eidan deploy` and are
# NEVER tracked here. Rather than name each private bundle (a leak + constant upkeep), default to
# ignoring everything and re-include only the open-source core. A new bundle needs no edit; adding
# a new CORE package/route means un-ignoring it below. Re-including the *directory* (not just the
# `*` glob) is required — otherwise the parent ignore also swallows NEW files inside a core dir.
packages/*
!packages/a2a-server/
!packages/auth/
!packages/frontend-agui/
!packages/frontend-telegram/
!packages/jobs/
!packages/llm-calls/
!packages/mcp-server/
!packages/memory/
!packages/notify/
!packages/procedures/
!packages/routines/
!packages/secrets-api/
!packages/social-bluesky/
!packages/social-instagram/
!packages/storage-postgres/
!packages/vault-postgres/
!packages/agents/
!packages/escalations/
!packages/decisions/
!packages/gdrive/
!packages/google/
!packages/ical/
!packages/imap/
!packages/telemetry/
!packages/transcribe/
!packages/tool-guard/
# thematic bundles folded into the AGPL core (kept as opt-in bundle plugins, not in CORE_PLUGINS)
!packages/charles-ventures/
!packages/charles-decks/

# Assembled plugin frontends: every subdir here is bundle-written. The committed *.generated.*
# base-case files sit directly in the dir (not a subdir), so the trailing-slash glob leaves them.
apps/web/src/plugins/*/

# Assembled API routes: ignore every route dir, re-include the core ones. (`\[...path\]` escapes
# the gitignore character-class brackets so the literal `[...path]` catch-all route matches.)
apps/web/src/app/api/*/
!apps/web/src/app/api/\[...path\]/
!apps/web/src/app/api/admin/
!apps/web/src/app/api/agent/
!apps/web/src/app/api/auth/
!apps/web/src/app/api/cost/
!apps/web/src/app/api/escalations/
!apps/web/src/app/api/events/
!apps/web/src/app/api/knowledge/
!apps/web/src/app/api/me/
!apps/web/src/app/api/openrouter/
!apps/web/src/app/api/notes/

# operator deploy config (per-deploy; targets + bundle paths)
eidan.deploy.json
# bundle catalogue — holds private repo names; survives re-init, never tracked
eidan.catalogue.json
.env.compose

# Capacitor native shell (apps/mobile). The ios/ and android/ native projects are
# generated by `cap add` and are re-creatable from capacitor.config.ts — not committed
# to core. Their build artifacts (Pods, .gradle, DerivedData, build/) are ignored too.
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.env
apps/mobile/.capacitor/
# (in case native projects are ever committed deliberately, still ignore their caches)
apps/mobile/**/Pods/
apps/mobile/**/Podfile.lock
apps/mobile/**/DerivedData/
apps/mobile/**/.gradle/
apps/mobile/**/build/
apps/mobile/**/local.properties
apps/mobile/**/xcuserdata/
apps/mobile/**/*.xcuserstate
